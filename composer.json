{
    "name": "sabbajohn/pulse-php",
    "description": "Framework-agnostic PHP client for the VoraPulse API.",
    "version": "0.1.5",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "Sabbajohn\\PulsePhp\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.5"
    },
    "scripts": {
        "test": "phpunit tests"
    }
}
